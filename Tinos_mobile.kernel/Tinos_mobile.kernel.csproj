<Project Sdk="Cosmos.Sdk/3.0.89">

  <PropertyGroup>
	  <CosmosEnableKeyboard>false</CosmosEnableKeyboard>
	  <CosmosEnableMouse>false</CosmosEnableMouse>
	  <CosmosEnableNetwork>false</CosmosEnableNetwork>
	  <CosmosEnablePci>false</CosmosEnablePci>
	  <CosmosEnableUART>false</CosmosEnableUART>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- Core kernel packages -->
  <ItemGroup>
    <PackageReference Include="Cosmos.Kernel" Version="3.0.89" />
    <PackageReference Include="Cosmos.Kernel.System" Version="3.0.89" />
  </ItemGroup>

</Project>
